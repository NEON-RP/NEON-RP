# NEON RP - FadeHost environment variables
# Fill these two secrets directly in FadeHost. Never publish them in GitHub.
DISCORD_BOT_TOKEN=PASTE_YOUR_BOT_TOKEN_IN_FADEHOST
APPLICATION_SHARED_SECRET=GENERATE_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS

# Server, roles, and application channels
DISCORD_GUILD_ID=1551369386630058025
STAFF_ROLE_ID=1551491292406612048
CITIZEN_ROLE_ID=1551504346796130415
POLICE_ROLE_ID=1559339151139151932
DISCORD_GENERAL_APPLICATION_CHANNEL_ID=1551502554494537768
DISCORD_POLICE_APPLICATION_CHANNEL_ID=1559338774276866068

# GitHub Pages project site (confirm Pages URL in repository Settings > Pages)
SITE_URL=https://neon-rp.github.io/NEON-RP/
ALLOWED_ORIGIN=https://neon-rp.github.io
PORT=3000
# Optional: set true only if the website sends x-application-secret
REQUIRE_SHARED_SECRET=false
